configuration {
    font: "JetBrainsMono Nerd Font 10";
    show-icons: false;
}

@import "~/.config/theme/catppuccin-mocha.rasi"

* {
    bg0:     #1e1e2ecc;
    bg1:     @surface0;
    fg:      @text;
    accent:  @blue;

    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         south east;
    anchor:           south east;
    x-offset:         -10px;
    y-offset:         -10px;
    width:            32%;
    border:           2px;
    border-color:     @accent;
    background-color: @bg0;
    padding:          12px;
}

mainbox {
    spacing:          8px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg1;
    padding:          8px 12px;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @accent;
    margin:           0px 8px 0px 0px;
}

entry {
    placeholder:      "Search song in playlist...";
    placeholder-color: @fg;
}

listview {
    columns:          1;
    lines:            8;
    cycle:            true;
    scrollbar:        true;
    spacing:          4px;
}

scrollbar {
    width:            4px;
    handle-width:     4px;
    handle-color:     @accent;
    background-color: @bg1;
    margin:           0px 0px 0px 4px;
}

element {
    padding:          6px 10px;
    text-color:       @fg;
}

element selected normal {
    background-color: @accent;
    text-color:       @bg0;
}

element-text {
    text-color:       inherit;
}
