@import "~/.config/theme/catppuccin-mocha.rasi"

configuration {
    modi: "window";
    show-icons: true;
    window-format: " {c} - {t}";
}

* {
    font:   "JetBrainsMono Nerd Font Medium 12";

    bg0:     @mantle;
    bg1:     @surface0;
    fg0:     @text;

    accent-color:     @blue;
    urgent-color:     @red;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    location:   center;
    width:      800;

    background-color:   @bg0;
}

inputbar {
    spacing:    8px;
    padding:    8px;

    background-color:   @bg1;
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

prompt {
    text-color: @accent-color;
}

textbox {
    padding:            8px;
    background-color:   @bg1;
}

listview {
    padding:    4px 0;
    lines:      8;
    columns:    1;

    fixed-height:   false;
    scrollbar:      true;
}


scrollbar {
    width:            4px;
    handle-width:     4px;
    handle-color:     @accent-color;
    background-color: @bg1;
    margin:           0px 0px 0px 4px;
}

element {
    padding:    8px;
    spacing:    8px;
}

element normal normal {
    text-color: @fg0;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @bg0;
}

element selected normal, element selected active {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @urgent-color;
}

element-icon {
    size:   0.8em;
}

element-text {
    text-color: inherit;
}
