 **/

/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

* {
    mainbox-margin:              400px 800px;
    mainbox-padding:             30px;

    background-window:           #11111bbf;
    background-normal:           #bac2de10;
    background-selected:         #89b4fa30;
    foreground-normal:           #bac2de;
    foreground-selected:         #89b4fa;

    mainbox-color:               #313244;

    font-textbox:                "JetBrainsMono Nerd Font 14";
    font-element:                "JetBrainsMono Nerd Font 40";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  true;
    width:                       500px;
    cursor:                      "default";
    background-color:            var(background-window);
}

/*****----- Main Box -----*****/
mainbox {
    spacing:                     30px;
    padding:                      var(mainbox-padding);
    margin:                      var(mainbox-margin);
    background-color:            var(mainbox-color);
    children:                    [ "message", "listview" ];
}

/*****----- Message -----*****/
message {
    margin:                      0px;
    padding:                     20px;
    background-color:            var(background-normal);
    text-color:                  var(foreground-normal);
}
textbox {
    font:                        var(font-textbox);
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    placeholder-color:           var(foreground-normal);
    blink:                       true;
    markup:                      true;
}

/*****----- Listview -----*****/
listview {
    expand:                      false;
    columns:                     2;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     30px;
    background-color:            transparent;
    text-color:                  var(foreground-normal);
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    padding:                     25px 10px;
    background-color:            var(background-normal);
    text-color:                  var(foreground-normal);
    cursor:                      pointer;
}
element-text {
    font:                        var(font-element);
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
element selected.normal {
    background-color:            var(background-selected);
    text-color:                  var(foreground-selected);
    border:                      1px solid;
    border-color:                var(foreground-selected);
}
