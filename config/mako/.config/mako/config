# Reference: https://github.com/catppuccin/mako

font=JetBrainsMono Nerd Font 10
width=350
height=110
margin=10
padding=12
border-size=2
#border-radius=10
anchor=top-right
layer=overlay

default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time

#group-by=summary
#format=<b>%s</b> (%g)\n%b

icons=1
max-icon-size=48
icon-location=left

background-color=#1e1e2edd
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #313244

[urgency=low]
background-color=#1e1e2edd
text-color=#a6adc8
border-color=#9399b2
default-timeout=3000

# Inspired by https://github.com/catppuccin/mako/blob/main/themes/catppuccin-mocha/catppuccin-mocha-blue
[urgency=normal]
background-color=#1e1e2edd
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244
default-timeout=5000

[urgency=high]
background-color=#1e1e2edd
text-color=#f38ba8
border-color=#f5c2e7
default-timeout=0

#[grouped]
#border-color=#89b4fa

[app-name=mpd]
default-timeout=2500
border-color=#fab387
text-color=#a6adc8
background-color=#1e1e2edd
