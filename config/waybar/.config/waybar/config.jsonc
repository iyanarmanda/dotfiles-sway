// -*- mode: jsonc -*-
{
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "custom/dnd",
        "custom/autolock",
        "mpd"
    ],
//    "modules-center": [
//        "mpd"
//    ],
    "modules-right": [
        "custom/uptime",
        "custom/updates",
        "pulseaudio",
        "backlight",
        "network",
        "battery",
        "clock",
        "tray"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", "󰖲"],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "clock": {
        "format": "{:%a, %d %b %Y | %H:%M}",
        "tooltip": false
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% ",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["󰂎", "󰁼", "󰁾", "󰂁", "󰁹"],
        "tooltip": false
    },
    "network": {
        "format-wifi": "{signalStrength}% 󰖩 via {ifname}",
        "format-disconnected": "Disconnected 󰖪",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰂲 {icon} {format_source}",
        "format-muted": "  {format_source}",
        "format-source": "{volume}% 󰍬",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["", "", ""]
        },
        "tooltip": false,
    },
    "mpd": {
        "format": "{stateIcon} [{singleIcon}{repeatIcon}{randomIcon}{consumeIcon}] {artist} - {title}",
        "max-length": 40,
        "min-length": 10,
        "format-disconnected": "󰝛 Disconnected",
        "format-stopped": "",
        "unknown-tag": "N/A",
        "interval": 5,
        "signal": 10,
        "consume-icons": {
            "on": "󰆐 "
        },
        "random-icons": {
            "on": "󰒝 "
        },
        "repeat-icons": {
            "on": "󰑖 "
        },
        "single-icons": {
            "on": "󰑘 "
        },
        "state-icons": {
            "paused": "󰏤",
            "playing": "󰐊"
        },
        "tooltip": false,
    },
    "tray": {
        "icon-size": 15,
        "spacing": 5,
        "orders": {
            "nm-applet": 99
        },
    },
    "custom/updates": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/package.sh",
        "return-type": "json",
        "interval": 3600,
        "signal": 8
    },
    "custom/uptime": {
        "format": "󰔛 {}",
        "exec": "uptime -p | sed -e 's/up //' -e 's/ hours\\?/h/' -e 's/ minutes\\?/m/' -e 's/ days\\?/d/'",
        "interval": 300,
        "tooltip": false,
    },
    "custom/dnd": {
        "exec": "~/.config/sway/scripts/toggle-notification.sh status",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": false
    },
    "custom/autolock": {
        "exec": "~/.config/sway/scripts/autolock.sh status",
        "interval": "once",
        "signal": 9,
        "format": "{}",
        "tooltip": false
},
}
